// =====================================================================
//  MindGuard AI — Prisma Schema
//  14 models. Postgres + pgvector.
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector]
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

enum UserRole {
  student
  counselor
  admin
}

enum MessageRole {
  student
  assistant
  counselor
}

enum AgentKind {
  conversation
  mood_analysis
  memory_pattern
  therapeutic
  crisis_detection
}

enum RiskTier {
  none
  low
  medium
  high
}

enum SeverityBand {
  minimal
  mild
  moderate
  moderately_severe
  severe
}

enum WellnessTrend {
  improving
  stable
  declining
  unknown
}

enum CaseStatus {
  open
  acknowledged
  resolved
  false_positive
}

// ---------------------------------------------------------------------
// 1. AUTH & PEOPLE
// ---------------------------------------------------------------------

/// Students and counselors share one table. Role-specific fields are
/// nullable — two extra profile models were not earning their keep.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  role         UserRole
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  university   String
  isActive     Boolean  @default(true) @map("is_active")

  // student fields
  program           String?
  yearOfStudy       Int?    @map("year_of_study") @db.SmallInt
  preferredLanguage String? @default("en") @map("preferred_language")
  emergencyContact  String? @map("emergency_contact")
  checkinHour       Int?    @map("checkin_hour") @db.SmallInt

  // counselor fields
  isOnCall Boolean @default(false) @map("is_on_call")
  phone    String?

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)

  consents         Consent[]
  conversations    Conversation[]
  messages         Message[]
  agentOutputs     AgentOutput[]
  assessments      Assessment[]
  interventionLogs InterventionLog[]
  memory           StudentMemory?
  notifications    Notification[]

  escalations   Escalation[] @relation("EscalationStudent")
  assignedCases Escalation[] @relation("EscalationCounselor")
  auditActions  AuditLog[]   @relation("AuditActor")
  auditSubjects AuditLog[]   @relation("AuditStudent")

  @@index([role, university])
  @@index([university, isOnCall])
  @@map("users")
}

/// Consent must be provable after the fact. Rows are never updated —
/// a withdrawal is a new row with granted = false.
model Consent {
  id            String   @id @default(uuid()) @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  scope         String // terms | data_processing | crisis_escalation | research_use
  granted       Boolean
  policyVersion String   @map("policy_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, scope, createdAt(sort: Desc)])
  @@map("consents")
}

// ---------------------------------------------------------------------
// 2. CONVERSATION & CHAT HISTORY  (one pair of tables, all 5 agents)
// ---------------------------------------------------------------------

model Conversation {
  id           String    @id @default(uuid()) @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  isCheckin    Boolean   @default(false) @map("is_checkin")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  messageCount Int       @default(0) @map("message_count")
  summary      String? // regenerated by the Memory Agent
  minWellness  Int?      @map("min_wellness") @db.SmallInt
  peakRisk     RiskTier  @default(none) @map("peak_risk")

  student          User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages         Message[]
  agentOutputs     AgentOutput[]
  assessments      Assessment[]
  interventionLogs InterventionLog[]

  @@index([studentId, startedAt(sort: Desc)])
  @@map("conversations")
}

/// Full chat history. The embedding lives on the row it belongs to, so
/// semantic recall over past conversations is one SQL query — no
/// separate ChromaDB service to keep in sync.
model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  studentId      String      @map("student_id") @db.Uuid
  seq            Int
  role           MessageRole
  content        String
  tokenCount     Int?        @map("token_count")

  /// pgvector. Prisma Client cannot select this column directly —
  /// read and write it with $queryRaw / $executeRaw.
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  agentOutputs AgentOutput[]

  @@unique([conversationId, seq])
  @@index([studentId, createdAt(sort: Desc)])
  @@map("messages")
}

// ---------------------------------------------------------------------
// 3. AGENT OUTPUT — one model, all five agents
// ---------------------------------------------------------------------

/// Every agent writes here. The columns the dashboard filters and sorts
/// on are hoisted out of the JSON; everything else (chain-of-thought,
/// the 3 self-consistency votes, linguistic markers) stays in `result`.
/// Adding a sixth agent needs no migration.
model AgentOutput {
  id             String  @id @default(uuid()) @db.Uuid
  messageId      String? @map("message_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  studentId      String  @map("student_id") @db.Uuid

  agent AgentKind

  // hoisted for querying
  wellnessScore  Int?          @map("wellness_score") @db.SmallInt
  sentiment      Decimal?      @db.Decimal(4, 3)
  primaryEmotion String?       @map("primary_emotion")
  depressionType String?       @map("depression_type") // -> KnowledgeBase.key
  severity       SeverityBand?
  riskTier       RiskTier?     @map("risk_tier")

  result        Json // full agent JSON
  promptVersion String @map("prompt_version")
  model         String

  latencyMs   Int?     @map("latency_ms")
  totalTokens Int?     @map("total_tokens")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  escalations  Escalation[]

  @@unique([messageId, agent])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([riskTier, createdAt(sort: Desc)])
  @@map("agent_outputs")
}

// ---------------------------------------------------------------------
// 4. CRISIS ESCALATION
// ---------------------------------------------------------------------

model Escalation {
  id        String     @id @default(uuid()) @db.Uuid
  studentId String     @map("student_id") @db.Uuid
  outputId  String     @map("output_id") @db.Uuid
  tier      RiskTier
  status    CaseStatus @default(open)
  summary   String // AI emotional profile handed to the counselor

  counselorId    String?   @map("counselor_id") @db.Uuid
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  outcome        String?

  student       User          @relation("EscalationStudent", fields: [studentId], references: [id])
  counselor     User?         @relation("EscalationCounselor", fields: [counselorId], references: [id])
  output        AgentOutput   @relation(fields: [outputId], references: [id])
  notifications Notification[]

  @@index([status, tier, openedAt])
  @@index([studentId, openedAt(sort: Desc)])
  @@map("escalations")
}

// ---------------------------------------------------------------------
// 5. CLINICAL INSTRUMENTS & INTERVENTIONS
// ---------------------------------------------------------------------

/// Item scores as an Int[] instead of a child response model — PHQ-9 is
/// always 9 items, GAD-7 always 7. A join buys nothing here.
model Assessment {
  id             String  @id @default(uuid()) @db.Uuid
  studentId      String  @map("student_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid

  instrument String // phq9 | gad7
  itemScores Int[]        @map("item_scores") @db.SmallInt
  totalScore Int          @map("total_score") @db.SmallInt
  severity   SeverityBand

  /// PHQ-9 item 9 asks about self-harm. A positive answer routes
  /// straight to the Crisis Agent regardless of the total score.
  safetyFlag Boolean  @default(false) @map("safety_flag")
  takenAt    DateTime @default(now()) @map("taken_at") @db.Timestamptz(6)

  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([studentId, instrument, takenAt(sort: Desc)])
  @@map("assessments")
}

/// The CBT / DBT / mindfulness library. Kept in the DB, not hardcoded in
/// prompts, so clinical content can be edited without a deploy.
model Intervention {
  id           Int      @id @default(autoincrement())
  code         String   @unique // 'grounding_54321'
  name         String
  modality     String // cbt | dbt | mbsr | behavioral_activation
  targetStates String[] @map("target_states") // {'anxiety','overwhelm'}
  rationale    String // the plain-language "why it works"
  script       String
  isActive     Boolean  @default(true) @map("is_active")

  logs InterventionLog[]

  @@map("interventions")
}

/// The whole personalisation loop: what was tried, what actually helped.
/// No training involved — it is a GROUP BY.
model InterventionLog {
  id             String @id @default(uuid()) @db.Uuid
  studentId      String @map("student_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  interventionId Int    @map("intervention_id")

  accepted       Boolean?
  helpfulness    Int?     @db.SmallInt
  wellnessBefore Int?     @map("wellness_before") @db.SmallInt
  wellnessAfter  Int?     @map("wellness_after") @db.SmallInt // measured ~24h later
  deliveredAt    DateTime @default(now()) @map("delivered_at") @db.Timestamptz(6)

  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  intervention Intervention @relation(fields: [interventionId], references: [id])

  @@index([studentId, deliveredAt(sort: Desc)])
  @@map("intervention_logs")
}

// ---------------------------------------------------------------------
// 6. MEMORY — one row per student
// ---------------------------------------------------------------------

/// Replaces context cards, trigger tracking, trend rollups and pattern
/// reports. The Memory Agent rewrites this row; every other agent reads it.
model StudentMemory {
  studentId String @id @map("student_id") @db.Uuid

  trend                  WellnessTrend @default(unknown)
  currentWellness        Decimal?      @map("current_wellness") @db.Decimal(3, 1)
  baselineWellness       Decimal?      @map("baseline_wellness") @db.Decimal(3, 1)
  consecutiveDeclineDays Int           @default(0) @map("consecutive_decline_days") @db.SmallInt

  triggers                 String[] @default([]) // {'exam periods','Sunday evenings'}
  effectiveInterventions   String[] @default([]) @map("effective_interventions")
  ineffectiveInterventions String[] @default([]) @map("ineffective_interventions")

  lastPhq9Score Int?      @map("last_phq9_score") @db.SmallInt
  lastPhq9At    DateTime? @map("last_phq9_at") @db.Timestamptz(6)

  /// Rendered card injected into every agent prompt, plus the
  /// structured findings behind it.
  contextCard     String? @map("context_card")
  patternFindings Json    @default("{}") @map("pattern_findings")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([trend, consecutiveDeclineDays(sort: Desc)])
  @@map("student_memory")
}

// ---------------------------------------------------------------------
// 7. KNOWLEDGE BASE — DSM-5, CBT, protocols, cultural guide, stressors
// ---------------------------------------------------------------------

/// All preloaded clinical content in one model. Retrieved by exact `key`
/// for static prompt injection, or by `embedding` for semantic RAG.
model KnowledgeBase {
  id      Int    @id @default(autoincrement())
  kind    String // dsm5 | cbt | crisis_protocol | cultural | stressors
  key     String @unique // 'major_depressive_disorder'
  title   String
  content String

  /// icd10 code, text markers, DSM-5 criteria
  metadata Json @default("{}")

  embedding Unsupported("vector(1536)")?

  version  String  @default("v1")
  isActive Boolean @default(true) @map("is_active")

  @@index([kind, isActive])
  @@map("knowledge_base")
}

// ---------------------------------------------------------------------
// 8. PROMPT VERSIONS
// ---------------------------------------------------------------------

/// No model training means the prompt IS the versioned artifact.
/// AgentOutput.promptVersion points here — that link is what makes the
/// evaluation numbers in the FYP report reproducible.
model PromptVersion {
  id          Int      @id @default(autoincrement())
  agent       AgentKind
  version     String
  template    String
  model       String // gpt-4.1 | gpt-5
  temperature Decimal  @db.Decimal(2, 1)
  isActive    Boolean  @default(false) @map("is_active")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([agent, version])
  @@map("prompt_versions")
}

// ---------------------------------------------------------------------
// 9. NOTIFICATIONS & AUDIT
// ---------------------------------------------------------------------

model Notification {
  id            String  @id @default(uuid()) @db.Uuid
  escalationId  String? @map("escalation_id") @db.Uuid
  recipientId   String  @map("recipient_id") @db.Uuid
  channel       String // sms | whatsapp | email | push
  status        String  @default("queued") // queued | sent | delivered | failed
  providerId    String? @map("provider_id") // Twilio / SendGrid message id
  error         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  escalation Escalation? @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  recipient  User        @relation(fields: [recipientId], references: [id])

  @@index([escalationId])
  @@map("notifications")
}

/// Every counselor read of a student's transcript. This is what makes
/// the Transparency section of the proposal demonstrable rather than
/// aspirational.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  studentId  String?  @map("student_id") @db.Uuid
  action     String // view_transcript | acknowledge | export | delete
  resourceId String?  @map("resource_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor   User? @relation("AuditActor", fields: [actorId], references: [id])
  student User? @relation("AuditStudent", fields: [studentId], references: [id])

  @@index([studentId, createdAt(sort: Desc)])
  @@map("audit_log")
}
